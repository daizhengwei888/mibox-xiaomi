{
  "manifest_version": 3,
  "name": "谜盒·灵动知识舱",
  "version": "1.0.0",
  "description": "面向小米浏览器手机与Pad的AI伴读与私有知识舱：提供网页触控灵动胶囊、长按划词AI精读与闪念笔记、四档全局护眼阅读跨标签同步、DNR净图过滤、智能收藏与AES-256-GCM加密保险箱，预置Xiaomi MiMo流式大模型与零配置本地智能引擎。",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "谜盒·灵动知识舱",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "app.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "alarms",
    "declarativeNetRequest",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/touch-assistant.js"
      ],
      "css": [
        "src/content/reading.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/16.png",
        "icons/48.png",
        "icons/128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
