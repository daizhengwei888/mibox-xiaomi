{
  "manifest_version": 3,
  "name": "谜盒·划词笔记",
  "version": "1.3.0",
  "description": "用网页显影找出数字、日期和限制条件，也能用扫描动画在原位置复原网页首屏。支持划词笔记、翻译和护眼阅读。",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "谜盒·划词笔记",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "app.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "alarms",
    "declarativeNetRequest",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/page-rebuild.js",
        "src/content/page-studio.js",
        "src/content/touch-assistant.js"
      ],
      "css": [
        "src/content/reading.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/16.png",
        "icons/48.png",
        "icons/128.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
